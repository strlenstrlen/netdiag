<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Network report · {{.Generated}}</title>
<style>{{template "style"}}</style>
</head>
<body>
<main>
  <h1>Network report</h1>
  <div class="meta">
    <span>{{.Generated}}</span><span>{{.Host}}</span><span>{{.OS}}</span><span>took {{.Elapsed}}</span>
  </div>
  {{if .Symptom}}<div class="meta" style="margin-top:4px">Reported problem: <b>{{.Symptom}}</b></div>{{end}}

  <section class="card verdict {{.V.Status}}">
    <span class="badge">{{.StatusLabel}}</span>
    <div class="headline">{{.V.Headline}}</div>
    {{if or .V.Owner .ShowConfidence}}<div class="owner">
      {{if .V.Owner}}Who can fix it: <b>{{.V.Owner}}</b>{{end}}
      {{if .ShowConfidence}}{{if .V.Owner}} · {{end}}Confidence: <b>{{.V.Confidence}}</b>{{end}}
    </div>{{end}}
    {{if or .V.Evidence .V.NextSteps}}
    <div class="cols">
      {{if .V.Evidence}}<div><h3>Why</h3><ul>{{range .V.Evidence}}<li>{{rich .}}</li>{{end}}</ul></div>{{end}}
      {{if .V.NextSteps}}<div><h3>What to do</h3><ol>{{range .V.NextSteps}}<li>{{rich .}}</li>{{end}}</ol></div>{{end}}
    </div>
    {{end}}
  </section>

  <h2>Checks</h2>
  <section class="card">
    {{range .Stages}}
    <div class="stage">
      <div class="stage-title">{{.Title}}</div>
      <ul class="checks">
        {{range .Checks}}<li class="{{.Status}}"><span class="mark">{{mark .Status}}</span><span class="name">{{.Name}}</span><span class="detail">{{.Detail}}</span></li>{{end}}
      </ul>
    </div>
    {{end}}
  </section>

  {{if .Notes}}
  <h2>Also noticed</h2>
  <section class="card">
    <ul class="notes">
      {{range .Notes}}<li class="sev-{{.Severity}}"><div class="t">{{rich .Title}}</div>{{range .Evidence}}{{if .}}<div class="ev">{{rich .}}</div>{{end}}{{end}}</li>{{end}}
    </ul>
  </section>
  {{end}}

  {{if .Charts}}
  <h2>Latency over {{.SeriesSeconds}} seconds</h2>
  <section class="card">
    {{range .Charts}}
    <div class="chart">
      <div class="label"><span><b>{{.Label}}</b> {{.Target}}</span><span class="sub">{{.Sub}}</span></div>
      {{.SVG}}
    </div>
    {{end}}
    <div class="caption">All lines share one time axis. Spikes at the same moment on the router and the internet lines
      mean the delay happens on the local network; spikes only on the internet lines mean it happens beyond the router.
      The dashed line is the spike threshold; red marks are lost packets.</div>
    {{if .CorrelationText}}<div class="caption">{{.CorrelationText}}</div>{{end}}
  </section>
  {{end}}

  {{if .Speed}}
  <h2>Speed</h2>
  <section class="card">
    <div class="table-wrap"><table>
      <tr><th>Test</th><th>Speed</th><th>Latency while busy</th><th class="data">Data</th></tr>
      {{range .Speed}}
      <tr>
        <td>{{.Direction}}<div class="dim">{{.Provider}}{{if .Server}} · {{.Server}}{{end}}</div></td>
        {{if .OK}}
        <td class="num">{{.Mbps}} Mbps<div class="bar" style="width: {{.BarPct}}%"></div></td>
        <td class="num">{{.Loaded}}</td>
        <td class="num data">{{.Data}}</td>
        {{else}}
        <td colspan="3" class="dim">{{.Err}}</td>
        {{end}}
      </tr>
      {{end}}
    </table></div>
    <div class="caption">Idle latency was {{.IdleLatency}}. The speed test used {{.DataMB}} of data.</div>
  </section>
  {{end}}

  <h2>Details</h2>
  {{range .Details}}
  <details>
    <summary>{{.Title}}</summary>
    <div class="table-wrap"><table>
      <tr>{{range .Head}}<th>{{.}}</th>{{end}}</tr>
      {{range .Rows}}<tr>{{range .}}<td>{{.}}</td>{{end}}</tr>{{end}}
    </table></div>
  </details>
  {{end}}

  <footer>
    Generated by netdiag {{.Version}}. The full measurements are embedded in this file:
    run <code>netdiag --from "{{.FileHint}}" -v</code> to see them in a terminal.
  </footer>
</main>
<script type="application/json" id="netdiag-data">NETDIAG_DATA_PLACEHOLDER</script>
</body>
</html>
