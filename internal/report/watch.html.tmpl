<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>Connection watch · {{.Started}}</title>
<style>{{template "style"}}</style>
</head>
<body>
<main>
  <h1>Connection watch</h1>
  <div class="meta">
    <span>{{.Started}}</span><span>watched for {{.Duration}}</span><span>{{.Host}}</span><span>{{.OS}}</span>
  </div>

  <section class="card verdict {{.StatusClass}}">
    <span class="badge">{{.StatusLabel}}</span>
    <div class="headline">{{.C.Headline}}</div>
    {{if .C.Owner}}<div class="owner">Who can fix it: <b>{{.C.Owner}}</b></div>{{end}}
    {{if or .C.Evidence .C.NextSteps}}
    <div class="cols">
      {{if .C.Evidence}}<div><h3>What happened</h3><ul>{{range .C.Evidence}}<li>{{rich .}}</li>{{end}}</ul></div>{{end}}
      {{if .C.NextSteps}}<div><h3>What to do</h3><ol>{{range .C.NextSteps}}<li>{{rich .}}</li>{{end}}</ol></div>{{end}}
    </div>
    {{end}}
    <div class="stats">
      {{range .Stats}}<div class="stat"><div class="v">{{.V}}</div><div class="k">{{.K}}</div></div>{{end}}
    </div>
  </section>

  <h2>Timeline</h2>
  <section class="card">
    {{.Timeline}}
    <div class="axis">{{range .Axis}}<span>{{.}}</span>{{end}}</div>
    <div class="legend">
      <span><i style="background: var(--line-2)"></i>internet latency</span>
      <span><i style="background: var(--line)"></i>router latency</span>
      <span><i style="background: var(--fail); opacity: .5"></i>offline</span>
      <span><i style="background: var(--warn); opacity: .5"></i>high latency</span>
      <span><i style="background: var(--info)"></i>Wi-Fi or network change</span>
    </div>
    <div class="caption">Latency is clipped at {{.ClipMs}} ms so short spikes don't flatten the rest. Gaps in a line are lost replies.</div>
  </section>

  <h2>Events</h2>
  <section class="card">
    {{if .Events}}
    <div class="table-wrap"><table>
      <tr><th>Time</th><th>What happened</th><th>Where</th></tr>
      {{range .Events}}
      <tr>
        <td class="num">{{.Time}}{{if .Dur}}<div class="dim">{{.Dur}}</div>{{end}}</td>
        <td>{{.Title}}{{if .Detail}}<div class="dim">{{.Detail}}</div>{{end}}</td>
        <td>{{if .Cause}}<span class="cause cause-{{.Cause}}">{{.CauseLabel}}</span>{{end}}</td>
      </tr>
      {{end}}
    </table></div>
    {{else}}
    <div class="dim">Nothing happened: no drops, latency episodes, DNS failures or network changes.</div>
    {{end}}
  </section>

  <footer>
    Generated by netdiag {{.Version}}: pinged the router and {{.Targets}} every {{.Interval}}, checked DNS every 10 s and the network settings every 5 s.
    The full timeline is embedded in this file: run <code>netdiag view "{{.FileHint}}"</code> to see it in a terminal.
  </footer>
</main>
<script type="application/json" id="netdiag-data">NETDIAG_DATA_PLACEHOLDER</script>
</body>
</html>
