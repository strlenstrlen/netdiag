{{define "style"}}
:root {
  --bg: #f6f6f3; --surface: #ffffff; --surface-2: #f0f0ec; --text: #1c1c1e; --muted: #66666b;
  --border: #e2e2dd; --ok: #1d7f47; --warn: #a86300; --fail: #c0302b; --info: #2c67ad;
  --ok-bg: #e7f4ec; --warn-bg: #fbf0df; --fail-bg: #fbe8e6; --info-bg: #e6eef8;
  --line: #2f6bd6; --line-2: #7a52d8; --thresh: #b9b9b3; --bar: #2f6bd6;
  --radius: 10px;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #141416; --surface: #1d1d20; --surface-2: #26262a; --text: #ececef; --muted: #a0a0a8;
    --border: #34343a; --ok: #4cc283; --warn: #f0a640; --fail: #ff6b62; --info: #6ea8f5;
    --ok-bg: #173323; --warn-bg: #3a2a12; --fail-bg: #3d1a18; --info-bg: #182a40;
    --line: #6ea8f5; --line-2: #b496ff; --thresh: #55555c; --bar: #6ea8f5;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
main { max-width: 880px; margin: 0 auto; padding: 24px 16px 48px; }
h1 { font-size: 22px; margin: 0 0 4px; letter-spacing: -0.01em; }
h2 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); margin: 32px 0 10px; }
.meta { color: var(--muted); font-size: 13px; }
.meta span + span::before { content: "·"; margin: 0 6px; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px 20px; }
.verdict { margin-top: 20px; border-left: 5px solid var(--status); }
.verdict.ok { --status: var(--ok); } .verdict.degraded { --status: var(--warn); } .verdict.fail { --status: var(--fail); }
.badge { display: inline-block; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
  padding: 2px 8px; border-radius: 999px; color: var(--status); background: var(--status-bg); }
.verdict.ok .badge { --status-bg: var(--ok-bg); } .verdict.degraded .badge { --status-bg: var(--warn-bg); } .verdict.fail .badge { --status-bg: var(--fail-bg); }
.headline { font-size: 20px; font-weight: 650; margin: 8px 0 4px; line-height: 1.3; }
.owner { color: var(--muted); font-size: 14px; }
.owner b { color: var(--text); font-weight: 600; }
.cols { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 14px; }
@media (max-width: 640px) { .cols { grid-template-columns: 1fr; } }
.cols h3 { font-size: 14px; margin: 0 0 6px; }
.cols ul, .cols ol { margin: 0; padding-left: 20px; }
.cols li { margin: 4px 0; }
.checks { list-style: none; margin: 0; padding: 0; }
.checks li { display: grid; grid-template-columns: 22px minmax(150px, 190px) 1fr; gap: 8px; padding: 9px 0; border-top: 1px solid var(--border); align-items: baseline; }
.checks li:first-child { border-top: 0; }
@media (max-width: 640px) { .checks li { grid-template-columns: 22px 1fr; } .checks .detail { grid-column: 2; } }
.mark { font-weight: 700; text-align: center; }
.pass .mark { color: var(--ok); } .warn .mark { color: var(--warn); } .fail .mark { color: var(--fail); } .skip .mark { color: var(--muted); }
.checks .name { font-weight: 550; }
.checks .detail { color: var(--muted); font-size: 14px; overflow-wrap: anywhere; }
.stage { margin-top: 12px; }
.stage + .stage { margin-top: 16px; }
.stage-title { font-size: 13px; font-weight: 600; color: var(--muted); margin-bottom: 2px; }
.notes { list-style: none; margin: 0; padding: 0; }
.notes li { padding: 10px 0; border-top: 1px solid var(--border); }
.notes li:first-child { border-top: 0; }
.notes .t { font-weight: 550; }
.notes .t::before { display: inline-block; width: 18px; font-weight: 700; }
.notes .sev-warn .t::before { content: "!"; color: var(--warn); }
.notes .sev-info .t::before { content: "i"; color: var(--info); }
.notes .ev { color: var(--muted); font-size: 14px; margin: 2px 0 0 18px; }
.chart { margin: 4px 0 14px; }
.chart .label { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; flex-wrap: wrap; }
.chart .label .sub { color: var(--muted); }
svg.spark { display: block; width: 100%; height: 56px; background: var(--surface-2); border-radius: 6px; }
svg.spark .l { fill: none; stroke: var(--line); stroke-width: 1.5; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
svg.spark .l.inet { stroke: var(--line-2); }
svg.spark .th { stroke: var(--thresh); stroke-width: 1; stroke-dasharray: 4 3; vector-effect: non-scaling-stroke; }
svg.spark .lost { fill: var(--fail); }
.caption { color: var(--muted); font-size: 13px; margin-top: 4px; }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th, td { text-align: left; padding: 7px 8px; border-top: 1px solid var(--border); vertical-align: top; }
th { color: var(--muted); font-weight: 550; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; border-top: 0; }
td.num { font-variant-numeric: tabular-nums; white-space: nowrap; }
.table-wrap { overflow-x: auto; }
@media (max-width: 640px) { .data { display: none; } td.num { white-space: normal; } th, td { padding: 7px 6px; } }
.bar { height: 6px; border-radius: 3px; background: var(--bar); margin-top: 4px; min-width: 2px; }
.dim { color: var(--muted); }
details { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); margin: 10px 0; }
details > summary { cursor: pointer; padding: 12px 16px; font-weight: 550; }
details > div { padding: 0 16px 14px; }
code { font: 13px ui-monospace, SFMono-Regular, Menlo, monospace; background: var(--surface-2); padding: 1px 5px; border-radius: 4px; overflow-wrap: anywhere; }
footer { margin-top: 32px; color: var(--muted); font-size: 13px; }

.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin-top: 14px; }
.stat { background: var(--surface-2); border-radius: 8px; padding: 10px 12px; }
.stat .v { font-size: 20px; font-weight: 650; font-variant-numeric: tabular-nums; }
.stat .k { color: var(--muted); font-size: 12px; }
svg.timeline { display: block; width: 100%; height: 170px; background: var(--surface-2); border-radius: 6px; }
svg.timeline .l { fill: none; stroke: var(--line-2); stroke-width: 1.5; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
svg.timeline .l.router { stroke: var(--line); }
svg.timeline .out { fill: var(--fail); opacity: 0.22; }
svg.timeline .lag { fill: var(--warn); opacity: 0.22; }
svg.timeline .ev { stroke: var(--info); stroke-width: 1; stroke-dasharray: 3 3; vector-effect: non-scaling-stroke; }
.axis { display: flex; justify-content: space-between; color: var(--muted); font-size: 12px; margin-top: 4px; }
.legend { display: flex; gap: 16px; flex-wrap: wrap; color: var(--muted); font-size: 12px; margin-top: 6px; }
.legend i { display: inline-block; width: 12px; height: 3px; vertical-align: middle; margin-right: 5px; border-radius: 2px; }
.cause { font-size: 12px; font-weight: 600; padding: 1px 7px; border-radius: 999px; white-space: nowrap; }
.cause-local, .cause-wifi { color: var(--warn); background: var(--warn-bg); }
.cause-upstream { color: var(--fail); background: var(--fail-bg); }
.cause-dns, .cause-config { color: var(--info); background: var(--info-bg); }
{{end}}
